# Build and application caches (never runtime source)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.cache/
*.egg-info/

# Colcon / ROS development outputs
ros/build/
ros/install/
ros/log/
ros/.colcon/
**/.ros/

# Host-generated logs, bags, dumps, and local state
*.log
*.log.*
*.db3
*.mcap
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.core
core.*
*.bag
*.bag.active
rosbags/
bags/
captures/
run/
tmp/
*.pid
*.sock
*.swp
*.swo
*~

# Preserve checked-in calibration assets and robot source intentionally.
# These patterns do not remove already tracked files.

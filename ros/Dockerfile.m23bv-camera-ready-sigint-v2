# M23BV strictly additive SIGINT-v2 readiness-only overlay.
# No device mappings, no command entrypoint changes, no camera/IMU runner changes.
# Base image must be individually SHA-pinned by the offline builder.
ARG M23BV_SIGINT_V2_BASE=localhost/leroy-sensors:m23bv-camera-ready-candidate
FROM ${M23BV_SIGINT_V2_BASE}

# THE ONLY OVERLAY: replaces the readiness checker in this new image tag only.
# The base candidate image and its launch/rectifier/M20 sources remain intact.
COPY m23bv_camera_ready_gate_sigint_v2.py /opt/m23bv/m23bv_camera_ready_gate.py

RUN . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && python3 -m py_compile /opt/m23bv/m23bv_camera_ready_gate.py \
    && python3 -c 'import launch, launch_ros, rclpy; print("M23BV_SIGINT_V2_JAZZY_IMPORTS=PASS")' \
    && echo M23BV_SIGINT_V2_SOURCE_BUILD=PASS

# Inherits the original offline-test ENTRYPOINT; never runs sensors by default.

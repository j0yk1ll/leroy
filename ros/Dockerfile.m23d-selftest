# M23D: read-only recorded ROS2 bag diagnostic; synthetic test data only.
# Base image is operator accepted LOCAL M23B image. No network installs.
ARG M23D_BASE=localhost/leroy-sensors:m23b-xrslam-monocular-test
FROM ${M23D_BASE}

ENV LEROY_NAV2_DRY_RUN=1 \
    M23D_OFFLINE_BAG_ONLY=1 \
    ROS_DOMAIN_ID=174 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m23d_recorded_bag_readiness.py /opt/m23d/m23d_recorded_bag_readiness.py
COPY m23d_recorded_bag_readiness_test.py /opt/m23d/m23d_recorded_bag_readiness_test.py
COPY m23d_synthetic_rosbag_profile_selftest.py /opt/m23d/m23d_synthetic_rosbag_profile_selftest.py
COPY m23d_no_device_run.sh /opt/m23d/m23d_no_device_run.sh
COPY Dockerfile.m23d-selftest /opt/m23d/Dockerfile.m23d-selftest
COPY m23d_no_device_run.sh /usr/local/bin/leroy-m23d-test-run

RUN chmod 0755 /usr/local/bin/leroy-m23d-test-run \
    && bash -n /usr/local/bin/leroy-m23d-test-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m23d:/opt/m23b:/opt/m23a:${PYTHONPATH:-}" \
    && python3 -m py_compile \
        /opt/m23d/m23d_recorded_bag_readiness.py \
        /opt/m23d/m23d_recorded_bag_readiness_test.py \
        /opt/m23d/m23d_synthetic_rosbag_profile_selftest.py \
    && python3 -u /opt/m23d/m23d_recorded_bag_readiness_test.py \
    && python3 -c 'import yaml, rosbag2_py; from sensor_msgs.msg import Imu; print("M23D_JAZZY_ROSBAG_IMPORT=PASS")'

CMD ["/usr/local/bin/leroy-m23d-test-run"]

# M22K: actual ROS node with non-actuating signed supervisor, FAKE CDC ONLY.
ARG LEROY_M22K_BASE_IMAGE=localhost/leroy-sensors:m22j-bridge-signed-audit
FROM ${LEROY_M22K_BASE_IMAGE}

ENV LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    M22F_FAKE_SERIAL_ONLY=1 \
    M22K_DIAGNOSTIC_SUPERVISOR_ONLY=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy exactly current bridge source on top of inherited old package.
COPY src/leroy_bridge/leroy_bridge/ /opt/m22k/leroy_bridge/
COPY m22i_isolated_role_signing.py /opt/m22k/m22i_isolated_role_signing.py
COPY m22f_fake_bridge_ros_selftest.py /opt/m22k/m22f_fake_bridge_ros_selftest.py
COPY m22k_real_bridge_supervisor_ros_selftest.py /opt/m22k/m22k_real_bridge_supervisor_ros_selftest.py
COPY m22k_no_device_run.sh /usr/local/bin/leroy-m22k-selftest-run

RUN chmod 0755 /usr/local/bin/leroy-m22k-selftest-run \
    && bash -n /usr/local/bin/leroy-m22k-selftest-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m22k:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m22k/leroy_bridge/node.py \
       /opt/m22k/leroy_bridge/bridge_signed_audit.py \
       /opt/m22k/leroy_bridge/bridge_diagnostic_supervisor.py \
       /opt/m22k/m22k_real_bridge_supervisor_ros_selftest.py \
    && python3 -c 'import leroy_bridge.node as b; from leroy_bridge.bridge_diagnostic_supervisor import BridgeDiagnosticSupervisor; assert b.__file__.startswith("/opt/m22k/"), b.__file__; print("M22K_BRIDGE_SUPERVISOR_IMPORT_SELFTEST=PASS")'

CMD ["/usr/local/bin/leroy-m22k-selftest-run"]

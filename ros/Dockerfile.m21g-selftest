# M21G: test terminal-fault latch after metadata callback failure.
# NO physical sensor devices, NO motor bridge, no serial START/STOP.
ARG LEROY_M21G_BASE_IMAGE=localhost/leroy-sensors:m21f-source-hook-selftest
FROM ${LEROY_M21G_BASE_IMAGE}

ENV LEROY_M20_SENSOR_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

# Overlay the guarded M18 source without changing any physical test image.
COPY m18_imu_stream_source.py /opt/m21g/m18_imu_stream_source.py
COPY m21g_fault_latch_selftest.py /opt/m21g/m21g_fault_latch_selftest.py
COPY m21g_no_device_selftest_run.sh /usr/local/bin/leroy-m21g-selftest-run

RUN chmod 0755 /usr/local/bin/leroy-m21g-selftest-run \
    && bash -n /usr/local/bin/leroy-m21g-selftest-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m21g:/opt/m21f:/opt/m21e:/opt/m20:/opt/m18:/opt/m18/monitor:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m21g/m18_imu_stream_source.py \
       /opt/m21g/m21g_fault_latch_selftest.py \
    && python3 -c 'from m18_imu_stream_source import ImuStreamSource; assert ImuStreamSource.__init__.__defaults__ == (None,); print("M21G_SOURCE_IMPORT_SELFTEST=PASS")'

CMD ["/usr/local/bin/leroy-m21g-selftest-run"]

# M19 isolated stationary IMU rate audit; inherits tested M18-only image,
# NOT the full robot startup; original leroy-ros container remains stopped.
ARG LEROY_M19_BASE_IMAGE=localhost/leroy-imu:m18-stamped-ros
FROM ${LEROY_M19_BASE_IMAGE}

ENV LEROY_M19_CLOCK_AUDIT=1 PYTHONDONTWRITEBYTECODE=1
COPY m19_imu_clock_audit.py /opt/m19/m19_imu_clock_audit.py
COPY m19_imu_clock_test.py /opt/m19/m19_imu_clock_test.py
COPY m19_imu_clock_run.sh /usr/local/bin/leroy-m19-clock-audit

RUN chmod 0755 /usr/local/bin/leroy-m19-clock-audit \
    && bash -n /usr/local/bin/leroy-m19-clock-audit \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && PYTHONPATH=/opt/m19:/opt/m18:/opt/m18/monitor \
       python3 -m unittest discover -s /opt/m19 -p m19_imu_clock_test.py -v \
    && LEROY_M19_SELFTEST=1 /usr/local/bin/leroy-m19-clock-audit

CMD ["/usr/local/bin/leroy-m19-clock-audit"]

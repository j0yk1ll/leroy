# Optional XRSLAM-enabled layer on top of Leroy's tested Jazzy/DepthART image.
# Build context: leroy/ros/
# First build the base image with: podman build -f Dockerfile -t leroy-ros:jazzy .
ARG LEROY_BASE_IMAGE=localhost/leroy-ros:jazzy
FROM ${LEROY_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
# Pin the independently maintained ROS-free XRSLAM source for repeatable builds.
ARG XRSLAM_REF=53adcdafd065ec1b2239b9d000205ea243e8342d
ARG XRSLAM_BUILD_JOBS=2

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    pkg-config \
    libopencv-dev \
    libblas-dev \
    liblapack-dev \
    libssl-dev \
    libyaml-cpp-dev \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libgl1-mesa-dev \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-yaml-cpp-vendor \
    && rm -rf /var/lib/apt/lists/*

# The XRSLAM core remains ROS-independent. Disable optional ML and GUI
# backends: neither is necessary for the Leroy monocular-inertial adapter.
RUN git clone https://github.com/j0yk1ll/xrslam.git /opt/xrslam \
    && git -C /opt/xrslam checkout --detach "${XRSLAM_REF}" \
    && test "$(git -C /opt/xrslam rev-parse HEAD)" = "${XRSLAM_REF}" \
    && cmake -S /opt/xrslam -B /opt/xrslam/build \
       -DXRSLAM_PC_HEADLESS_ONLY=ON \
       -DXRSLAM_ENABLE_PIDNET=OFF \
       -DXRSLAM_ENABLE_EIGENPLACES=OFF \
       -DXRSLAM_ENABLE_USEARCH=OFF \
    && cmake --build /opt/xrslam/build --target xrslam -j"${XRSLAM_BUILD_JOBS}" \
    && test -s /opt/xrslam/lib/libxrslam.so

# The base Leroy image intentionally excludes this optional ROS package.
COPY src/leroy_xrslam /leroy_ws/src/leroy_xrslam

RUN . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && cd /leroy_ws \
    && colcon build --symlink-install --packages-select leroy_xrslam \
       --cmake-args \
       -DXRSLAM_ROOT=/opt/xrslam \
       -DXRSLAM_LIBRARY=/opt/xrslam/lib/libxrslam.so

# Resolve libxrslam.so without relying on an interactive shell's environment.
RUN printf '/opt/xrslam/lib\n' > /etc/ld.so.conf.d/leroy-xrslam.conf \
    && ldconfig \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && test -x /leroy_ws/install/leroy_xrslam/lib/leroy_xrslam/leroy_xrslam_node \
    && ! ldd /leroy_ws/install/leroy_xrslam/lib/leroy_xrslam/leroy_xrslam_node | grep -q 'not found' \
    && ros2 pkg executables leroy_xrslam | grep -qx 'leroy_xrslam leroy_xrslam_node'

# Inherit the Leroy base image's default command. The integrated bringup
# still sets use_xrslam:=false unless explicitly configured otherwise.

# M23N: camera-only, no production transport QoS changes.
# Stacked on accepted local M23M synthetic QoS experiment image.
FROM localhost/leroy-sensors:m23m-synthetic-qos

ENV M23K_PROBE_MODE=selftest \
    M23K_PROBE_VARIANT=raw_only_mjpeg \
    M23N_CAMERA_QOS_ONLY=0 \
    LEROY_M20_SENSOR_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m23k_camera_path_probe.py /opt/m23k/m23k_camera_path_probe.py
COPY m23n_camera_qos_probe_test.py /opt/m23n/m23n_camera_qos_probe_test.py
COPY m23n_operator_camera_qos_probe.sh /opt/m23n/m23n_operator_camera_qos_probe.sh
COPY Dockerfile.m23n-camera-qos /opt/m23n/Dockerfile.m23n-camera-qos

RUN chmod 0755 /opt/m23n/m23n_operator_camera_qos_probe.sh \
    && bash -n /opt/m23n/m23n_operator_camera_qos_probe.sh \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m23n:/opt/m23m:/opt/m23l:/opt/m23k:/opt/m20:${PYTHONPATH:-}" \
    && python3 -m py_compile \
        /opt/m23k/m23k_camera_path_probe.py \
        /opt/m23n/m23n_camera_qos_probe_test.py \
    && python3 -u /opt/m23n/m23n_camera_qos_probe_test.py \
    && test -x /opt/m23m-cpp-install/lib/leroy_m23k_camera_counter/m23k_camera_header_counter \
    && test -f /opt/m23k/m23k_camera_raw_only.launch.py \
    && echo M23N_JAZZY_CAMERA_QOS_IMPORT=PASS

CMD ["/usr/local/bin/leroy-m23k-camera-probe"]

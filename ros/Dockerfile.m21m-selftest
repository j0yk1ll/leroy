# M21M: synthetic ROS producer errors must invalidate lifecycle after joins.
# Inherit previously operator-validated M21L no-device simulator runtime.
ARG LEROY_M21M_BASE_IMAGE=localhost/leroy-sensors:m21l-ros-quiescence-selftest
FROM ${LEROY_M21M_BASE_IMAGE}

ENV LEROY_M20_SENSOR_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m21k_offline_quiescence.py /opt/m21m/m21k_offline_quiescence.py
COPY m21k_offline_quiescence_test.py /opt/m21m/m21k_offline_quiescence_test.py
COPY m21l_ros_executor_quiescence_selftest.py /opt/m21m/m21l_ros_executor_quiescence_selftest.py
COPY m21m_producer_fault_test.py /opt/m21m/m21m_producer_fault_test.py
COPY m21m_no_device_run.sh /usr/local/bin/leroy-m21m-selftest-run

RUN chmod 0755 /usr/local/bin/leroy-m21m-selftest-run \
    && bash -n /usr/local/bin/leroy-m21m-selftest-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m21m:/opt/m21l:/opt/m21h:/opt/m21g:/opt/m21f:/opt/m21e:/opt/m20:/opt/m18:/opt/m18/monitor:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m21m/m21k_offline_quiescence.py \
       /opt/m21m/m21l_ros_executor_quiescence_selftest.py \
       /opt/m21m/m21m_producer_fault_test.py \
    && python3 -m unittest discover -s /opt/m21m \
       -p m21k_offline_quiescence_test.py -v \
    && python3 -c 'from m21k_offline_quiescence import finish_after_quiescence; print("M21M_FAULT_HOOK_IMPORT_SELFTEST=PASS")'

CMD ["/usr/local/bin/leroy-m21m-selftest-run"]

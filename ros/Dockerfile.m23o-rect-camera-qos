# M23O: no-device build atop accepted M23N; full M20 camera+rectifier
# is launched only through the separately approved host wrapper.
FROM localhost/leroy-sensors:m23n-real-camera-qos

ENV M23K_PROBE_MODE=selftest \
    M23K_PROBE_VARIANT=full_mjpeg \
    M23N_CAMERA_QOS_ONLY=0 \
    M23O_RECT_QOS_ONLY=0 \
    LEROY_M20_SENSOR_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/m23o:/opt/m23n:/opt/m23m:/opt/m23l:/opt/m23k:/opt/m20

COPY m23k_camera_path_probe.py /opt/m23k/m23k_camera_path_probe.py
COPY m23o_rect_qos_graph.py /opt/m23o/m23o_rect_qos_graph.py
COPY m23o_rect_camera_qos_test.py /opt/m23o/m23o_rect_camera_qos_test.py
COPY m23o_operator_camera_rect_qos.sh /opt/m23o/m23o_operator_camera_rect_qos.sh
COPY Dockerfile.m23o-rect-camera-qos /opt/m23o/Dockerfile.m23o-rect-camera-qos

RUN chmod 0755 /opt/m23o/m23o_operator_camera_rect_qos.sh \
    && bash -n /opt/m23o/m23o_operator_camera_rect_qos.sh \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && python3 -m py_compile \
       /opt/m23k/m23k_camera_path_probe.py \
       /opt/m23o/m23o_rect_qos_graph.py \
       /opt/m23o/m23o_rect_camera_qos_test.py \
    && python3 -c "from rclpy.utilities import get_rmw_implementation_identifier" \
    && python3 -u /opt/m23o/m23o_rect_camera_qos_test.py \
    && test -x /opt/m23m-cpp-install/lib/leroy_m23k_camera_counter/m23k_camera_header_counter \
    && test -f /opt/m20/m20_camera_only.launch.py \
    && echo M23O_JAZZY_RECT_QOS_IMPORT=PASS

CMD ["/usr/local/bin/leroy-m23k-camera-probe"]

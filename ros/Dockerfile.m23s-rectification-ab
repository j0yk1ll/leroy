# M23S: same traced component + fabricated publisher, vary ONLY CameraInfo.D.
# Inherit operator-validated M23R local image; no upstream ROS rebuild or hardware.
FROM localhost/leroy-sensors:m23r-shutdown-trace

ENV M23S_AB_ONLY=1 \
    M23S_DISTORTION_PROFILE=passthrough \
    M23P_PROFILE=synthetic \
    M23P_SYNTHETIC_ONLY=1 \
    M23R_TRACE_ONLY=1 \
    M23K_PROBE_MODE=selftest \
    M23N_CAMERA_QOS_ONLY=0 \
    M23O_RECT_QOS_ONLY=0 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/m23s:/opt/m23r:/opt/m23p:/opt/m23o:/opt/m23n:/opt/m23m:/opt/m23l:/opt/m23k:/opt/m20

COPY m23s_cpp /opt/m23s/m23s_cpp
COPY m23s_rectification_ab.py /opt/m23s/m23s_rectification_ab.py
COPY m23s_compare_ab_logs.py /opt/m23s/m23s_compare_ab_logs.py
COPY m23s_rectification_ab_test.py /opt/m23s/m23s_rectification_ab_test.py
COPY M23S_RECTIFICATION_AB.md /opt/m23s/M23S_RECTIFICATION_AB.md
COPY Dockerfile.m23s-rectification-ab /opt/m23s/Dockerfile.m23s-rectification-ab

RUN . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && PYTHONDONTWRITEBYTECODE=1 python3 -u /opt/m23s/m23s_rectification_ab_test.py \
    && colcon --log-base /tmp/m23s-cpp-build-logs build \
       --base-paths /opt/m23s/m23s_cpp \
       --build-base /tmp/m23s-cpp-build \
       --install-base /opt/m23s-cpp-install \
       --merge-install \
       --packages-select leroy_m23s_rectification_ab \
    && test -x /opt/m23s-cpp-install/lib/leroy_m23s_rectification_ab/m23s_ab_publisher \
    && test -x /opt/m23p-cpp-install/lib/leroy_m23p_calibrated_synthetic/m23p_calibrated_publisher \
    && test -f /opt/m23r/libm23r_loader_trace.so \
    && echo M23S_NO_DEVICE_AB_IMAGE_CONTRACT=PASS

CMD ["/bin/bash", "-lc", ". /opt/ros/jazzy/setup.sh && . /leroy_ws/install/setup.sh && python3 -u /opt/m23s/m23s_rectification_ab.py"]

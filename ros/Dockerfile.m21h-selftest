# M21H: M20 real-runner cleanup regression with strictly simulated CDC.
# No device nodes mapped. Override the base image's existing CMD.
ARG LEROY_M21H_BASE_IMAGE=localhost/leroy-sensors:m21g-fault-latch-selftest
FROM ${LEROY_M21H_BASE_IMAGE}

ENV LEROY_M20_SENSOR_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m20_combined_observer.py /opt/m21h/m20_combined_observer.py
COPY m21h_fake_cdc_cleanup_test.py /opt/m21h/m21h_fake_cdc_cleanup_test.py
COPY m21h_no_device_selftest_run.sh /usr/local/bin/leroy-m21h-selftest-run

RUN chmod 0755 /usr/local/bin/leroy-m21h-selftest-run \
    && bash -n /usr/local/bin/leroy-m21h-selftest-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m21h:/opt/m21g:/opt/m21f:/opt/m21e:/opt/m20:/opt/m18:/opt/m18/monitor:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m21h/m20_combined_observer.py \
       /opt/m21h/m21h_fake_cdc_cleanup_test.py \
    && python3 -c 'from m20_combined_observer import run; print("M21H_M20_IMPORT_SELFTEST=PASS")'

CMD ["/usr/local/bin/leroy-m21h-selftest-run"]

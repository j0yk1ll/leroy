Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Reference Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Color: 85; 95; 105
      Alpha: 0.35
    - Class: rviz_default_plugins/TF
      Name: Robot TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/Map
      Name: Rolling Occupancy Grid
      Enabled: true
      Topic:
        Value: /leroy/navigation/occupancy_grid
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Scheme: map
      Alpha: 0.85
    - Class: rviz_default_plugins/Map
      Name: Nav2 Global Costmap
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Scheme: costmap
      Alpha: 0.65
    - Class: rviz_default_plugins/Map
      Name: Nav2 Local Costmap
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Scheme: costmap
      Alpha: 0.65
    - Class: rviz_default_plugins/Path
      Name: Nav2 Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.08
      Color: 50; 180; 250
      Alpha: 1
    - Class: rviz_default_plugins/Pose
      Name: Goal Marker
      Enabled: true
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 170; 35
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: Robot Odometry
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Keep: 120
      Shape:
        Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Raw Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: XRSLAM Tracked Features
      Enabled: true
      Topic:
        Value: /xrslam/tracked_features/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PointCloud2
      Name: XRSLAM Sparse Landmarks
      Enabled: true
      Topic:
        Value: /xrslam/landmarks
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 214; 85
      Alpha: 0.9
  Enabled: true
  Global Options:
    Background Color: 24; 29; 37
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Map
      Angle: 0
      Scale: 70
      Target Frame: odom
    Saved: ~
Window Geometry:
  Width: 1500
  Height: 950
  X: 80
  Y: 70

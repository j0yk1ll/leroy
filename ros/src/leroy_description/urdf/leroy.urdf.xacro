<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leroy">

  <!-- Body frames: +x forward, +y left, +z up -->
  <!-- Optical frames: +x right, +y down, +z forward -->
  <!-- All hardware-specific fixed sensor mounting coordinates are in YAML.
       The optical-axis conversion joints below are ROS frame conventions. -->
  <xacro:arg name="sensor_mounts_file"
             default="$(find leroy_description)/config/sensor_mounts.yaml"/>
  <xacro:property name="mount_file_path" value="$(arg sensor_mounts_file)"/>
  <xacro:property name="mount_config"
                  value="${xacro.load_yaml(mount_file_path)}"/>
  <xacro:property name="mounts" value="${mount_config['mounts']}"/>
  <xacro:macro name="sensor_origin" params="sensor">
    <origin xyz="${mounts[sensor]['xyz'][0]} ${mounts[sensor]['xyz'][1]} ${mounts[sensor]['xyz'][2]}"
            rpy="${mounts[sensor]['rpy'][0]} ${mounts[sensor]['rpy'][1]} ${mounts[sensor]['rpy'][2]}"/>
  </xacro:macro>

  <link name="base_link"/>

  <!-- PROVISIONAL IMU sensor centre, configured in sensor_mounts.yaml;
       the MCU output is ALREADY robot-aligned. -->
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <xacro:sensor_origin sensor="imu"/>
  </joint>

  <!-- PROVISIONAL front camera mounting transform from YAML. -->
  <link name="front_camera_link"/>
  <joint name="base_to_front_camera" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <xacro:sensor_origin sensor="front_camera"/>
  </joint>

  <link name="front_camera_optical_frame"/>
  <joint name="front_camera_to_optical" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <!--
    Compatibility alias for the current camera driver frame_id.
    Remove this after the front camera is configured to publish
    front_camera_optical_frame directly.
  -->
  <link name="camera_optical_frame"/>
  <joint name="front_optical_to_legacy_camera_optical" type="fixed">
    <parent link="front_camera_optical_frame"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- PROVISIONAL workspace camera mounting transform from YAML. -->
  <link name="workspace_camera_link"/>
  <joint name="base_to_workspace_camera" type="fixed">
    <parent link="base_link"/>
    <child link="workspace_camera_link"/>
    <xacro:sensor_origin sensor="workspace_camera"/>
  </joint>

  <link name="workspace_camera_optical_frame"/>
  <joint name="workspace_camera_to_optical" type="fixed">
    <parent link="workspace_camera_link"/>
    <child link="workspace_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

</robot>

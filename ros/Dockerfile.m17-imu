# M17: isolated MCU IMU read-only query audit, not the normal ROS robot.
# Inherited motor bridge binaries are NOT started; no ROS processes/commands.
# ONLY map the explicitly verified host MCU tty to /dev/ttyACM0.
ARG LEROY_SENSOR_BASE_IMAGE=localhost/leroy-ros:jazzy-lowpwm
FROM ${LEROY_SENSOR_BASE_IMAGE}
COPY m17_imu_query_probe.py /opt/m17/m17_imu_query_probe.py
COPY m17_imu_probe_test.py /opt/m17/m17_imu_probe_test.py
RUN PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s /opt/m17 -p m17_imu_probe_test.py -v \
    && PYTHONDONTWRITEBYTECODE=1 python3 /opt/m17/m17_imu_query_probe.py --self-test
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python3", "-u", "/opt/m17/m17_imu_query_probe.py", "--duration-sec", "15"]

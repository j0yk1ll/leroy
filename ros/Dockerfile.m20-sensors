# M20 concurrent real USB front camera + real timestamped MCU IMU, NO motors.
# Reuse operator-validated M19 image with M18 source, M16 passive monitor and
# existing patched camera/rectifier ROS runtime/calibration from original base.
# Never use inherited motor-capable entrypoint. No DepthART is started.
ARG LEROY_M20_BASE_IMAGE=localhost/leroy-imu:m19-clock-audit
FROM ${LEROY_M20_BASE_IMAGE}

ENV LEROY_M20_SENSOR_ONLY=1 \
    LEROY_M19_CLOCK_AUDIT=0 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m20_camera_only.launch.py /opt/m20/m20_camera_only.launch.py
COPY m20_combined_contract.py /opt/m20/m20_combined_contract.py
COPY m20_combined_observer.py /opt/m20/m20_combined_observer.py
COPY m20_combined_test.py /opt/m20/m20_combined_test.py
COPY Dockerfile.m20-sensors /opt/m20/Dockerfile.m20-sensors
COPY m20_sensor_only_run.sh /usr/local/bin/leroy-m20-sensor-run

RUN chmod 0755 /usr/local/bin/leroy-m20-sensor-run \
    && bash -n /usr/local/bin/leroy-m20-sensor-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m20:/opt/m18:/opt/m18/monitor:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m20/m20_camera_only.launch.py \
       /opt/m20/m20_combined_contract.py /opt/m20/m20_combined_observer.py \
    && python3 -c 'import rclpy, launch, launch_ros; from m20_combined_observer import receipt_overlap; print("M20_ROS_IMPORT_SELFTEST=PASS")' \
    && test -s /config/camera/front_camera.yaml \
    && ros2 pkg executables usb_cam | grep -Fx 'usb_cam usb_cam_node_exe' \
    && test -f /opt/ros/jazzy/lib/rclcpp_components/component_container \
    && python3 -m unittest discover -s /opt/m20 -p m20_combined_test.py -v \
    && LEROY_M20_SELFTEST=1 /usr/local/bin/leroy-m20-sensor-run

CMD ["/usr/local/bin/leroy-m20-sensor-run"]

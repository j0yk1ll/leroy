# M23M QoS matrix: synthetic 640x480 RGB8 DDS, zero devices
FROM localhost/leroy-sensors:m23l-synthetic-image-dds

ENV M23M_CPP_INSTALL_ROOT=/opt/m23m-cpp-install \
    M23M_SUB_QOS=best_effort_5 \
    M23L_SYNTHETIC_DDS_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

# Rebuild only the changed C++ receiver QoS profile support. Synthetic
# publisher remains byte-identical in source, no physical device maps.
COPY m23k_cpp /opt/m23k_cpp
COPY m23l_synthetic_dds_baseline.py /opt/m23l/m23l_synthetic_dds_baseline.py
COPY m23m_dds_qos_matrix_test.py /opt/m23m/m23m_dds_qos_matrix_test.py
COPY Dockerfile.m23m-qos /opt/m23m/Dockerfile.m23m-qos

RUN . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m23m:/opt/m23l:/opt/m23k:/opt/m20:${PYTHONPATH:-}" \
    && python3 -m py_compile \
        /opt/m23l/m23l_synthetic_dds_baseline.py \
        /opt/m23m/m23m_dds_qos_matrix_test.py \
    && python3 -u /opt/m23l/m23l_synthetic_dds_baseline_test.py \
    && python3 -u /opt/m23m/m23m_dds_qos_matrix_test.py \
    && colcon --log-base /tmp/m23m-cpp-build-logs build \
       --base-paths /opt/m23k_cpp \
       --build-base /tmp/m23m-cpp-build \
       --install-base /opt/m23m-cpp-install \
       --merge-install \
       --packages-select leroy_m23k_camera_counter \
    && test -x /opt/m23m-cpp-install/lib/leroy_m23k_camera_counter/m23l_synthetic_image_publisher \
    && test -x /opt/m23m-cpp-install/lib/leroy_m23k_camera_counter/m23k_camera_header_counter \
    && echo M23M_JAZZY_QOS_CPP_BUILD=PASS

CMD ["/usr/local/bin/leroy-m23l-no-device-run"]

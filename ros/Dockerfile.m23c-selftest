# M23C: synthetic VIO camera+IMU into real XRSLAM C++ binary, no hardware.
# Base is the operator-validated LOCAL M23B synthetic XRSLAM image.
ARG M23C_BASE=localhost/leroy-sensors:m23b-xrslam-monocular-test
FROM ${M23C_BASE}

ENV LEROY_NAV2_DRY_RUN=1 \
    M23C_SYNTHETIC_VIO_ONLY=1 \
    ROS_DOMAIN_ID=173 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m23c_synthetic_vio_bag.py /opt/m23c/m23c_synthetic_vio_bag.py
COPY m23c_real_xrslam_synthetic_vio_selftest.py /opt/m23c/m23c_real_xrslam_synthetic_vio_selftest.py
COPY m23c_synthetic_vio_contract_test.py /opt/m23c/m23c_synthetic_vio_contract_test.py
# The Python contract opens these two SOURCE files under /opt/m23c.
COPY m23c_no_device_run.sh /opt/m23c/m23c_no_device_run.sh
COPY Dockerfile.m23c-selftest /opt/m23c/Dockerfile.m23c-selftest
COPY m23c_no_device_run.sh /usr/local/bin/leroy-m23c-test-run

RUN chmod 0755 /usr/local/bin/leroy-m23c-test-run \
    && bash -n /usr/local/bin/leroy-m23c-test-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m23c:/opt/m23b:/opt/m23a:${PYTHONPATH:-}" \
    && python3 -m py_compile \
       /opt/m23c/m23c_synthetic_vio_bag.py \
       /opt/m23c/m23c_real_xrslam_synthetic_vio_selftest.py \
       /opt/m23c/m23c_synthetic_vio_contract_test.py \
    && python3 -u /opt/m23c/m23c_synthetic_vio_contract_test.py \
    && python3 -c 'import rclpy, rosbag2_py; from sensor_msgs.msg import Imu; print("M23C_JAZZY_VIO_IMPORT=PASS")' \
    && test -x /leroy_ws/install/leroy_xrslam/lib/leroy_xrslam/leroy_xrslam_node \
    && test -s /opt/xrslam/configs/euroc_slam.yaml \
    && test -s /opt/xrslam/configs/euroc_sensor.yaml \
    && ! ldd /leroy_ws/install/leroy_xrslam/lib/leroy_xrslam/leroy_xrslam_node | grep -q 'not found'

CMD ["/usr/local/bin/leroy-m23c-test-run"]

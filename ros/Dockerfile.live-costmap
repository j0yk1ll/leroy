# Optional second integration stage. Reuse the validated real DepthART image.
# Adds the Nav2 costmap executable ONLY; no bridge serial mapping/motor control.
FROM localhost/leroy-ros:perception

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ros-jazzy-nav2-costmap-2d \
      ros-jazzy-nav2-util \
      python3-yaml \
    && rm -rf /var/lib/apt/lists/*

COPY src/leroy_nav2_costmap_fixture /leroy_ws/src/leroy_nav2_costmap_fixture
COPY src/leroy_nav2_perception /leroy_ws/src/leroy_nav2_perception
# Stage 1's base image may carry an older description.launch.py.
# Force this branch's six static TF owners into the installed overlay.
COPY src/leroy_description /leroy_ws/src/leroy_description

RUN bash -lc 'set -e; \
    source /opt/ros/jazzy/setup.bash; \
    source /leroy_ws/install/setup.bash; \
    cd /leroy_ws; \
    colcon build --symlink-install \
       --packages-select leroy_description leroy_nav2_costmap_fixture leroy_nav2_perception; \
    source /leroy_ws/install/setup.bash; \
    ros2 pkg executables leroy_nav2_costmap_fixture | grep -Fx \
       "leroy_nav2_costmap_fixture costmap_fixture"; \
    ros2 pkg executables leroy_nav2_perception | grep -Fx \
       "leroy_nav2_perception live_costmap_probe"; \
    grep -Fq "static_transform_publisher" /leroy_ws/install/leroy_description/share/leroy_description/launch/description.launch.py'

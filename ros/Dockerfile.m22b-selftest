# M22B: ROS 2 DDS authority integration with fake publishers only.
# Rootless test image based on operator-validated M21M no-device Jazzy runtime.
ARG LEROY_M22B_BASE_IMAGE=localhost/leroy-sensors:m21m-producer-fault-selftest
FROM ${LEROY_M22B_BASE_IMAGE}

ENV LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

COPY m22a_diagnostic_authority.py /opt/m22b/m22a_diagnostic_authority.py
COPY m22a_diagnostic_authority_test.py /opt/m22b/m22a_diagnostic_authority_test.py
COPY m22b_isolated_ros_authority_selftest.py /opt/m22b/m22b_isolated_ros_authority_selftest.py
COPY m22b_no_device_run.sh /usr/local/bin/leroy-m22b-selftest-run

RUN chmod 0755 /usr/local/bin/leroy-m22b-selftest-run \
    && bash -n /usr/local/bin/leroy-m22b-selftest-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m22b:/opt/m21m:/opt/m21l:/opt/m21h:/opt/m21g:/opt/m21f:/opt/m21e:/opt/m20:/opt/m18:/opt/m18/monitor:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m22b/m22a_diagnostic_authority.py \
       /opt/m22b/m22a_diagnostic_authority_test.py \
       /opt/m22b/m22b_isolated_ros_authority_selftest.py \
    && python3 -c 'from m22a_diagnostic_authority import DiagnosticAuthority; from m22b_isolated_ros_authority_selftest import SyntheticAuthorityNode; print("M22B_ROS_IMPORT_SELFTEST=PASS")'

CMD ["/usr/local/bin/leroy-m22b-selftest-run"]

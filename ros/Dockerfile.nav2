# Optional, hardware-free Nav2 Jazzy development image.
# Build from the ros/ directory; never replace the running leroy-ros container.
FROM docker.io/osrf/ros:jazzy-desktop

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DOMAIN_ID=167 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    LEROY_NAV2_DRY_RUN=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-yaml \
    python3-pytest \
    python3-numpy \
    ros-jazzy-sensor-msgs-py \
    ros-jazzy-tf2-ros \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-ament-cmake-pytest \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /leroy_ws
# Deliberately exclude bridge, sensors, XRSLAM, motor drivers and robot bringup.
COPY src/leroy_nav2 /leroy_ws/src/leroy_nav2
COPY src/leroy_nav2_perception /leroy_ws/src/leroy_nav2_perception
COPY src/leroy_nav2_costmap_fixture /leroy_ws/src/leroy_nav2_costmap_fixture
COPY src/leroy_nav2_odometry /leroy_ws/src/leroy_nav2_odometry
COPY src/leroy_nav2_integration /leroy_ws/src/leroy_nav2_integration
# Copy the build recipe only so the static safety/quoting regression test can inspect it.
COPY Dockerfile.nav2 /leroy_ws/Dockerfile.nav2

RUN . /opt/ros/jazzy/setup.sh \
    && colcon build --packages-select leroy_nav2 leroy_nav2_perception leroy_nav2_costmap_fixture leroy_nav2_odometry leroy_nav2_integration --cmake-args -DBUILD_TESTING=ON \
    && . /leroy_ws/install/setup.sh \
    && colcon test --python-testing pytest --return-code-on-test-failure \
         --packages-select leroy_nav2 leroy_nav2_perception leroy_nav2_costmap_fixture leroy_nav2_odometry leroy_nav2_integration --event-handlers console_direct+ \
    && colcon test-result --verbose \
    && ros2 pkg executables nav2_controller | grep -Fx 'nav2_controller controller_server' \
    && ros2 pkg executables nav2_lifecycle_manager | grep -Fx 'nav2_lifecycle_manager lifecycle_manager' \
    && ros2 pkg prefix nav2_mppi_controller \
    && ros2 pkg executables nav2_costmap_2d | grep -Fx 'nav2_costmap_2d nav2_costmap_2d' \
    && ros2 pkg executables leroy_nav2_perception | grep -Fx 'leroy_nav2_perception depth_obstacles' \
    && ros2 pkg executables leroy_nav2_costmap_fixture | grep -Fx 'leroy_nav2_costmap_fixture costmap_fixture' \
    && ros2 pkg executables leroy_nav2_odometry | grep -Fx 'leroy_nav2_odometry synthetic_odom' \
    && ros2 pkg executables leroy_nav2_odometry | grep -Fx 'leroy_nav2_odometry odom_probe' \
    && ros2 pkg executables leroy_nav2_integration | grep -Fx 'leroy_nav2_integration integrated_probe' \
    && ros2 pkg executables leroy_nav2_integration | grep -Fx 'leroy_nav2_integration controller_probe'

# A non-running shell is the default: starting any Nav2 node is deliberate.
CMD ["/bin/bash"]

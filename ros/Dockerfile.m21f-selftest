# M21F: isolated real M18 publish-path metadata hook under synthetic ROS input.
# M18 source file is patched only in this derived test image; no hardware
# runner is executed and no device nodes are passed to the container.
ARG LEROY_M21F_BASE_IMAGE=localhost/leroy-sensors:m21e-ros-selftest
FROM ${LEROY_M21F_BASE_IMAGE}

ENV LEROY_M20_SENSOR_ONLY=1 \
    LEROY_NAV2_DRY_RUN=1 \
    ROS_DOMAIN_ID=170 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    PYTHONDONTWRITEBYTECODE=1

# Prefer the modified M18 source for this synthetic-only integration test.
COPY m18_imu_stream_source.py /opt/m21f/m18_imu_stream_source.py
COPY m21f_imu_source_hook_selftest.py /opt/m21f/m21f_imu_source_hook_selftest.py
COPY m21f_no_device_selftest_run.sh /usr/local/bin/leroy-m21f-selftest-run

RUN chmod 0755 /usr/local/bin/leroy-m21f-selftest-run \
    && bash -n /usr/local/bin/leroy-m21f-selftest-run \
    && . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && export PYTHONPATH="/opt/m21f:/opt/m21e:/opt/m20:/opt/m18:/opt/m18/monitor:${PYTHONPATH:-}" \
    && python3 -m py_compile /opt/m21f/m18_imu_stream_source.py \
       /opt/m21f/m21f_imu_source_hook_selftest.py \
    && python3 -c 'from m18_imu_stream_source import ImuStreamSource; assert ImuStreamSource.__init__.__defaults__ == (None,); print("M21F_M18_HOOK_IMPORT_SELFTEST=PASS")'

CMD ["/usr/local/bin/leroy-m21f-selftest-run"]

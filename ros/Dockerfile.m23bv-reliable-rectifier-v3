# M23BV standalone deterministic RELIABLE raw-reader prototype (v3).
# NOT production, not accepted v1/v2; no device mapping or motor command.
ARG M23BV_V3_BASE=localhost/leroy-sensors:m23bv-camera-ready-sigint-v2
FROM ${M23BV_V3_BASE}

# Add a SEPARATELY NAMED ament package: never overwrite image_proc or
# the original camera/rectifier launch, sensor runner, M20 or recorder.
COPY m23bv_reliable_rectifier_proto/ \
    /opt/m23bv_reliable_rectifier_proto/ws/src/m23bv_reliable_rectifier/
COPY m23bv_reliable_rectifier_v3_candidate.launch.py \
    /opt/m23bv/m23bv_reliable_rectifier_v3_candidate.launch.py

# Offline build only. This will FAIL CLOSED if compiler, colcon, headers, or
# dev libs are absent in the pinned v2 base; no apt/network fallback allowed.
RUN . /opt/ros/jazzy/setup.sh \
    && . /leroy_ws/install/setup.sh \
    && command -v g++ \
    && command -v colcon \
    && cd /opt/m23bv_reliable_rectifier_proto/ws \
    && colcon build --packages-select m23bv_reliable_rectifier \
        --event-handlers console_direct+ --cmake-args -DBUILD_TESTING=OFF \
    && . install/setup.sh \
    && test -x "$(ros2 pkg prefix m23bv_reliable_rectifier)/lib/m23bv_reliable_rectifier/m23bv_rectify_reliable_node" \
    && python3 -m py_compile /opt/m23bv/m23bv_reliable_rectifier_v3_candidate.launch.py \
    && echo M23BV_V3_RELIABLE_RECTIFIER_OFFLINE_COMPILE=PASS

# Inherits inert offline-unit-test ENTRYPOINT from v2. NEVER selected
# by physical m23bv_sensor_only_run.sh or original M20 launch.

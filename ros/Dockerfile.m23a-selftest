# M23A: read-only XRSLAM input bag audit, synthetic bag fixture only.
# Requires a locally present XRSLAM Jazzy image; NO pulls or network.
ARG LEROY_M23A_BASE_IMAGE=localhost/leroy-ros:xrslam
FROM ${LEROY_M23A_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    LEROY_NAV2_DRY_RUN=1 \
    M23A_BAG_REPLAY_PREFLIGHT_ONLY=1 \
    ROS_DOMAIN_ID=171 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

COPY m23a_xrslam_rosbag_preflight.py /opt/m23a/m23a_xrslam_rosbag_preflight.py
COPY m23a_xrslam_rosbag_preflight_test.py /opt/m23a/m23a_xrslam_rosbag_preflight_test.py
COPY m23a_rosbag_roundtrip_selftest.py /opt/m23a/m23a_rosbag_roundtrip_selftest.py
COPY m23a_no_device_run.sh /usr/local/bin/leroy-m23a-test-run

RUN chmod 0755 /usr/local/bin/leroy-m23a-test-run \
    && bash -n /usr/local/bin/leroy-m23a-test-run \
    && python3 -m py_compile /opt/m23a/m23a_xrslam_rosbag_preflight.py \
       /opt/m23a/m23a_xrslam_rosbag_preflight_test.py \
       /opt/m23a/m23a_rosbag_roundtrip_selftest.py \
    && . /opt/ros/jazzy/setup.sh \
    && export PYTHONPATH="/opt/m23a:${PYTHONPATH:-}" \
    && python3 -c 'import rosbag2_py; from rclpy.serialization import deserialize_message; from sensor_msgs.msg import Image, CameraInfo, Imu; print("M23A_JAZZY_ROSBAG_IMPORT_SELFTEST=PASS")' \
    && python3 -u /opt/m23a/m23a_xrslam_rosbag_preflight_test.py

CMD ["/usr/local/bin/leroy-m23a-test-run"]

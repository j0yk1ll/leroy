# Stage 4A only: add the existing M18 validated IMU ROS publisher to a
# device-isolated sidecar. Does not start a bridge or an XRSLAM VIO adapter.
FROM localhost/leroy-ros:costmap

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-serial && rm -rf /var/lib/apt/lists/*

# M18 imports the existing read-only M16 observer library at module scope;
# install its Python package but DO NOT launch its synthetic Nav2 fixtures.
COPY src/leroy_nav2_integration /leroy_ws/src/leroy_nav2_integration
RUN bash -lc 'set -e; source /opt/ros/jazzy/setup.bash; \
    source /leroy_ws/install/setup.bash; cd /leroy_ws; \
    colcon build --packages-select leroy_nav2_integration; \
    source /leroy_ws/install/setup.bash; \
    python3 -c "from leroy_nav2_integration.m16_passive_observer import PassiveSensorObserver"'

COPY m18_imu_stream_contract.py /opt/stage4/m18_imu_stream_contract.py
COPY m18_imu_stream_source.py /opt/stage4/m18_imu_stream_source.py
COPY live_stage4_imu_overlap.py /opt/stage4/live_stage4_imu_overlap.py
COPY live_stage4b_delivery_trace.py /opt/stage4/live_stage4b_delivery_trace.py
COPY live_stage4b_spin_budget.py /opt/stage4/live_stage4b_spin_budget.py
ENV PYTHONPATH=/opt/stage4
RUN python3 -m py_compile /opt/stage4/m18_imu_stream_source.py \
    /opt/stage4/m18_imu_stream_contract.py \
    /opt/stage4/live_stage4_imu_overlap.py \
    /opt/stage4/live_stage4b_delivery_trace.py \
    /opt/stage4/live_stage4b_spin_budget.py
CMD ["/bin/false"]
